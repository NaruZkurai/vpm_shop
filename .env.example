# HTTP/HTTPS
# Defaults to unused Cloudflare-proxyable ports: 2095 (HTTP) or 2096 (USE_TLS=1).
# (80, 8080, 443, 8443 are already taken by other services on this machine.)
# Cloudflare also proxies these origins:
#   HTTP:   80, 8080, 8880, 2052, 2082, 2086, 2095
#   HTTPS:  443, 2053, 2083, 2087, 2096, 8443
PORT=2095

# Set to 1/true to serve HTTPS instead of HTTP
USE_TLS=0

# PEM certificate + private key used when USE_TLS=1.
# If missing, a self-signed cert is auto-generated on first start (dev only).
TLS_CERT=certs/server.crt
TLS_KEY=certs/server.key

# Where the "not authorised" access log (with client IPs) is written.
ACCESS_LOG=logs/access.log

# Optional: tracing filter (defaults to info)
RUST_LOG=info
